# ==========================================
# Honbab Diary Environment Variables Template
# 이 파일을 복사하여 .env 파일을 만들고 실제 값을 채워넣으세요.
# 명령어: cp .env.example .env
# ==========================================

# Database Password
DB_PASSWORD=

# JWT Secret (Base64 encoded string)
JWT_SECRET=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# External APIs
YOUTUBE_API_KEY=
GEMINI_API_KEY=
